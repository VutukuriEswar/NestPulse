# Long random string in production — e.g. generate with:
JWT_SECRET_KEY=change-me-to-a-long-random-string

# How long a login session (JWT) stays valid, in hours
JWT_ACCESS_HOURS=12

# MongoDB connection string (local default; swap for Atlas later, e.g.
MONGO_URI=mongodb://localhost:27017/nestpulse
MONGO_DB_NAME=nestpulse

# Server port and debug mode
PORT=5000
FLASK_DEBUG=true