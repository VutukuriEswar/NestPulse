# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# Long random string in production — e.g. generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# How long a login session (JWT) stays valid, in hours
JWT_ACCESS_HOURS=12

# Where JSON data files are stored (users, families, devices)
DATA_DIR=./data

# Server port and debug mode
PORT=5000
FLASK_DEBUG=true
